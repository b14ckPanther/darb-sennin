# Copy to .env (git-ignored) and fill in local values. Never commit .env.
# Every key the code or compose reads must appear here with a safe placeholder.

# --- Runtime mode ---
# normal | demo  (demo shows the "Demo data" banner and loads content/demo + config/seed/demo)
SENNIN_MODE=normal

# --- MongoDB (compose: mongo:8 single-node replica set rs0) ---
# MongoDB 8.3 and 8.0.x images refuse to start on Linux kernels 6.19 to 7.0.13
# (SERVER-121912); Docker Desktop on this Mac ships 7.0.12. 8.2 starts. See docs/PROGRESS.md rulings.
SENNIN_MONGO_IMAGE=mongo:8.2
SENNIN_MONGO_PORT=27017
SENNIN_MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
SENNIN_MONGO_DATABASE=sennin
# Mongo Express (dev only)
SENNIN_MONGO_EXPRESS_PORT=8081

# --- Azure Service Bus emulator (compose) ---
# The emulator only accepts its documented local development key; it is not a real secret.
SENNIN_SERVICEBUS_AMQP_PORT=5672
SENNIN_SERVICEBUS_HTTP_PORT=5300
SENNIN_SERVICEBUS_CONNECTION=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
SENNIN_QUEUE_JUDGE_JOBS=judge-jobs
SENNIN_QUEUE_JUDGE_RESULTS=judge-results
# How long tools/compose-up.sh waits for the stack to report healthy.
SENNIN_COMPOSE_WAIT_SECONDS=240

# SQL Edge backs the Service Bus emulator. Choose a strong local-only password
# (8+ chars, upper, lower, digit, symbol).
SENNIN_SQL_PASSWORD=change-me-Local-0nly!
SENNIN_SQL_ACCEPT_EULA=Y

# --- Content and config ---
SENNIN_CONTENT_PATH=./content/demo
# Folder holding grading.yaml, ranks.yaml, schemas/ and the rest; checked at startup.
SENNIN_CONFIG_PATH=./config

# --- Reviewer LLM (Phase 7). fixture | record | live. CI and tests always use fixture. ---
SENNIN_LLM_MODE=fixture
SENNIN_LLM_API_KEY=

# --- Web client (Vite dev proxy target for /api and /hubs) ---
SENNIN_API_ORIGIN=http://localhost:5080
# Port for the Playwright preview server
SENNIN_WEB_E2E_PORT=4173
