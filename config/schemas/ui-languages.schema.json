{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sennin.zangeel.dev/schemas/ui-languages.schema.json",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "default": {
      "enum": [
        "python",
        "csharp",
        "javascript"
      ]
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "python",
              "csharp",
              "javascript",
              "pseudo"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "short": {
            "type": "string",
            "minLength": 1
          },
          "editor": {
            "enum": [
              "python",
              "csharp",
              "javascript",
              "plain"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "short",
          "editor"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "default",
    "languages"
  ],
  "additionalProperties": false,
  "description": "config/ui/languages.json"
}
