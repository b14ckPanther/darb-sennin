{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sennin.zangeel.dev/schemas/content-set.schema.json",
  "type": "object",
  "properties": {
    "set": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[0-9]{4}\\.[0-9]{2}(\\.[0-9]+)?)?$"
    },
    "demo": {
      "type": "boolean"
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "set",
    "contentVersion",
    "demo",
    "description"
  ],
  "additionalProperties": false,
  "description": "content/<set>/set.yaml"
}
