{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sennin.zangeel.dev/schemas/tags.schema.json",
  "type": "object",
  "properties": {
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "tags"
  ],
  "additionalProperties": false,
  "description": "config/tags.yaml: mistake taxonomy."
}
