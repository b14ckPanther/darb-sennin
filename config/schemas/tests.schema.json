{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sennin.zangeel.dev/schemas/tests.schema.json",
  "type": "object",
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "input": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "revealOnFail": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "input",
          "expected"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "description": "content/<set>/<slug>/tests/{sample,hidden}.yaml. Case ids are unique across both files; the validator checks that."
}
