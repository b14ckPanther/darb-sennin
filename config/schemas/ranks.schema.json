{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sennin.zangeel.dev/schemas/ranks.schema.json",
  "type": "object",
  "properties": {
    "ranks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "threshold": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "threshold",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ranks"
  ],
  "additionalProperties": false,
  "description": "config/ranks.yaml: rank ladder. Thresholds rise strictly; the loader checks order."
}
