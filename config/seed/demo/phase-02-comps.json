      "code": [
        "public static int[][] Merge(int[][] spans)",
        "{",
        "    if (spans.Length == 0) return [];",
        "    var sorted = spans.OrderBy(s => s[0]).ToArray();",
        "    var merged = new List<int[]> { sorted[0] };",
        "    foreach (var s in sorted.Skip(1))",
        "    {",
        "        var last = merged[^1];",
        "        if (s[0] <= last[1]) last[1] = Math.Max(last[1], s[1]);",
        "        else merged.Add(s);",
        "    }",
        "    return [.. merged];",
        "}"
      ]
    }
