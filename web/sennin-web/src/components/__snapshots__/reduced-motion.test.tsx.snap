exports[`reduced motion > Button 1`] = `"<button type="button" data-variant="primary" class="inline-flex min-h-touch select-none items-center justify-center gap-2 rounded-control px-4 text-callout font-medium transition-colors duration-(--duration-micro) disabled:cursor-not-allowed disabled:opacity-45 bg-primary text-primary-ink hover:bg-primary/90"><span>Submit</span></button>"`;

