exports[`reduced motion > PraiseLine stamp is placed, not pressed in 1`] = `"<div role="note" aria-label="Praise, earned by the gate" class="flex items-center gap-4"><span class="inline-grid shrink-0 -rotate-6 place-items-center rounded-[5px] border-2 border-stamp px-2 py-1 font-display text-callout leading-none text-stamp-ink" style="opacity: 1; transform: none;">Earned</span><p class="font-display text-title-3 text-praise-ink">Clean.</p></div>"`;

exports[`reduced motion > Sheet opens at its detent without sliding 1`] = `"<div role="dialog" aria-modal="true" aria-labelledby="_r_0_" data-detent="1" class="absolute inset-x-0 bottom-0 mx-auto flex max-w-2xl flex-col rounded-t-panel border border-b-0 border-line bg-surface pb-[env(safe-area-inset-bottom)] shadow-sheet" style="touch-action: auto; user-select: auto; height: 60dvh; transform: none;"><button type="button" aria-label="Drag to resize" class="mx-auto grid min-h-touch w-24 shrink-0 cursor-grab touch-none place-items-center rounded-chip"><span class="h-1 w-9 rounded-full bg-line-strong"></span></button><header class="flex touch-none items-center justify-between gap-4 px-5 pb-2"><h2 id="_r_0_" class="font-display text-title-3 text-ink">Filters</h2><button type="button" class="grid size-touch place-items-center rounded-control text-ink-muted hover:bg-surface-sunk hover:text-ink"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" role="img" aria-label="Close" focusable="false"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><path d="M14.5 9.50002L9.5 14.5M9.49998 9.5L14.5 14.5"></path></g></svg></button></header><div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 pb-5">body</div></div>"`;

